    {
      "id": 9,
      "type": "heatmap",
      "title": "Distribuição da latência (heatmap)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 16,
        "h": 9
      },
      "description": "Cada coluna é um intervalo de tempo; quanto mais forte a cor, mais requisições naquela faixa de latência",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(http_server_request_duration_milliseconds_bucket{service_name=\"server\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "exemplar": false,
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "yAxis": {
          "unit": "ms",
          "axisPlacement": "left"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "scale": "exponential",
          "exponent": 0.5,
          "steps": 64,
          "fill": "dark-orange",
          "reverse": false
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        },
        "legend": {
          "show": true
        },
        "filterValues": {
          "le": 1e-09
        }
      }
