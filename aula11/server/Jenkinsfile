pipeline {
    agent any

    environment {
        SPRING_PROFILES_ACTIVE="prod"
        SERVER_PORT=8080

        POSTGRESQL_CRED = credentials('postgres_id')
        DATABASE_URL="jdbc:postgresql://postgresql:5432/pw45s"
        DATABASE_USERNAME="${POSTGRESQL_CRED_USR}"
        DATABASE_PASSWORD="${POSTGRESQL_CRED_PSW}"

        GOOGLE_CRED = credentials('pw45s_google_client_id')
        GOOGLE_CLIENT_ID="${GOOGLE_CRED_USR}"

        STORAGE_CRED = credentials('pw45s_storage_id')
        STORAGE_ENDPOINT="https://rustfs.viniciuspegorini.com.br"
        STORAGE_PORT=443
        STORAGE_ACCESS_KEY="${STORAGE_CRED_USR}"
        STORAGE_SECRET_KEY="${STORAGE_CRED_PSW}"
        STORAGE_SECURE=true
        STORAGE_BUCKET_NAME="pw45s"

        // Sem coletor OTLP (Grafana LGTM) no servidor de produção
        OTLP_ENABLED=false
    }

    stages {
        stage('Docker Compose UP') {
            steps {
                // O Jenkins faz o checkout do repositório completo (pw45s); a API está na pasta aula11/server
                dir('aula11/server') {
                    sh 'docker compose up -d --build'
                }
            }
        }
    }
}
